# Заголовки для Cloudflare Pages (на softnote.org). Локально их не читают —
# там то же самое делает serve.json.
#
# Код сайта (HTML, JS, CSS): браузер может хранить копию, но перед каждым
# использованием спрашивает сервер «не изменилось?» (no-cache — это не «не
# хранить», а «сверяться»). Если нет — сервер отвечает коротким «304, бери
# своё», и всё быстро. Если да — браузер сразу берёт новую версию. Без этого
# после обновления сайта у людей открывалась бы старая.
/*
  Cache-Control: no-cache

# Шрифты не меняются никогда (новый шрифт — новое имя файла), поэтому их
# браузер хранит год и не спрашивает
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
